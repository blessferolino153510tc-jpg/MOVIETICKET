
package movieticket;

import java.util.Scanner;


public class MovieTicket {

    
    public static void main(String[] args) {
       Scanner input = new Scanner(System.in);
       
       String movieTitle;
       double ticketPrice;
       int numberOfTickets;
       double totalcost;
       
       System.out.print("Movie Title: ");
       movieTitle = input.nextLine();
       
       System.out.print("Ticket Price: ");
       ticketPrice = input.nextDouble();
       
       System.out.print("Number of Tickets: ");
       numberOfTickets = input.nextInt();
       
        double totalCost = ticketPrice * numberOfTickets;
        
        System.out.println("=== MOVIE TICKET RECEIPT ===");
        System.out.println("Movie Title:" + movieTitle);
        System.out.println("Ticket Price:" + ticketPrice);
        System.out.println("Number of Tickets:" + numberOfTickets);
        System.out.println("Tocal Cost:" + totalCost);
        
        input.close();
        
       
       
       
    }
    
}
